```sql
-- Módulo 2 - Unidad 1: Diseño de tablas
-- SQL Server

-- Tabla de clientes
CREATE TABLE clientes (
    id_cliente INT,                  -- Número entero para identificar al cliente.
    nombre VARCHAR(100),             -- Texto de hasta 100 caracteres.
    perfil_bio VARCHAR(MAX),         -- Texto largo para biografía o notas.
    fecha_registro DATE              -- Almacena solamente la fecha.
);

-- Tabla de productos
CREATE TABLE productos (
    id_producto INT,                 -- Número entero para identificar el producto.
    descripcion VARCHAR(255),        -- Texto de hasta 255 caracteres.
    precio DECIMAL(10,2),            -- Precio con hasta 10 dígitos y 2 decimales.
    esta_activo BIT                  -- 1 = activo y 0 = inactivo.
);
```
